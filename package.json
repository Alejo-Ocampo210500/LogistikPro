{
  "name": "logistikpro",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace=apps/frontend",
    "lint": "npm run lint --workspace=apps/frontend",
    "dev:frontend": "set -a && . ./env/frontend.env && set +a && npm --prefix apps/frontend run serve",
    "docker:up": "docker compose --env-file env/api.env -f docker/compose/docker-compose.yml up --build -d",
    "docker:down": "docker compose --env-file env/api.env -f docker/compose/docker-compose.yml down",
    "docker:logs": "docker compose --env-file env/api.env -f docker/compose/docker-compose.yml logs -f"
  }
}
